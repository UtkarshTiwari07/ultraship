# Pick one provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Pin a dated snapshot in deployment so a provider-side update cannot change
# extraction behaviour silently.
RATECON_OPENAI_MODEL=gpt-4.1
RATECON_ANTHROPIC_MODEL=claude-sonnet-4-5
# deepseek-chat is a legacy alias retired mid-2026; current IDs are
# deepseek-v4-flash / deepseek-v4-pro. Set the one your account exposes.
RATECON_DEEPSEEK_MODEL=deepseek-chat
