# Pick one provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Pin a dated snapshot in deployment so a provider-side update cannot change
# extraction behaviour silently.
RATECON_OPENAI_MODEL=gpt-4.1
RATECON_ANTHROPIC_MODEL=claude-sonnet-4-5
# DeepSeek current model IDs: deepseek-v4-pro / deepseek-v4-flash.
RATECON_DEEPSEEK_MODEL=deepseek-v4-pro
# reasoning_effort: v4-pro accepts high|max (low -> high); v4-flash also low.
RATECON_DEEPSEEK_REASONING_EFFORT=high
# thinking mode: enabled (default) | disabled
RATECON_DEEPSEEK_THINKING=enabled
